--- !u!114 &1594953919
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1594953917}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 099a8fd4c3ec1f64a8e07c8e04d02a02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueText: {fileID: 1594953920}
  continueIndicator: {fileID: 0}
  lines:
  - text: Hi my lovelies. Welcome back to my cooking show.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "I\u2019m Candy\u2606."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "Today, I\u2019ll teach you all how to make tiramisu. It\u2019s very delicious
      and easy to make."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "Take a look at your In your CookingCandyBox\u2606. You can put some mascarpone
      cream in the bowl."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: Mix, then set it aside.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: You will also find a few ladyfingers, an egg based biscuit. Soak them in
      the coffee mixture and put them in the pan.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: Layer the mascarpone cream on top of the ladyfingers.
    flagToSet: 
    pauseForObjective: 1
    objectiveId: day1step1
  - text: Finally, add a thin layer of the cocoa powder.
    flagToSet: 
    pauseForObjective: 1
    objectiveId: day1step2
  - text: There we go, a nice tiramisu. Ready to serve!
    flagToSet: 
    pauseForObjective: 1
    objectiveId: day1step3
  - text: "I hope you all enjoy this nice dessert. Whenever you eat my cooking, I
      become\u2026 a part of you."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  voiceClips: []
  voiceSource: {fileID: 0}
  voiceVolume: 1
  cutOnLineEndClips: []
  autoLoadNextLevel: 1
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
