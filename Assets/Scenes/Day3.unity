--- !u!114 &1594953919
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1594953917}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 099a8fd4c3ec1f64a8e07c8e04d02a02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueText: {fileID: 1594953920}
  continueIndicator: {fileID: 0}
  screenSprite: {fileID: 951332509}
  lines:
  - text: Hi my lovelies. Welcome back to my cooking show.
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    - hands hide
    - hair short
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "I\u2019m Candy\u2606."
    flagToSet: 
    spriteUpdates:
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "Today, I\u2019ll teach you all how to make tiramisu. It\u2019s very delicious
      and easy to make."
    flagToSet: 
    spriteUpdates:
    - shortcut hungry
    - eyes shut
    - hands hide
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "Take a look at your In your CookingCandyBox\u2606. "
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: 'You can put some coffee mixture in the bowl, and a few ladyfingers, an
      egg based biscuit. '
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    - hands hide
    - eyes shut
    pauseForObjective: 1
    objectiveId: day3step1
    showFoodDisplay: 0
  - text: Mix them in.
    flagToSet: 
    spriteUpdates:
    - shortcut stare
    - eyes shut
    pauseForObjective: 1
    objectiveId: day3step2
    showFoodDisplay: 0
  - text: Wait patiently, let them to soak in the coffee mixture.
    flagToSet: 
    spriteUpdates:
    - eyes shut
    pauseForObjective: 1
    objectiveId: day3step3
    showFoodDisplay: 0
  - text: Get the cocoa powder ready.
    flagToSet: 
    spriteUpdates:
    - eyes shut
    pauseForObjective: 1
    objectiveId: day3step4
    showFoodDisplay: 0
  - text: Finally, layer the mascarpone cream on top of the ladyfingers. Add a thin
      layer of the cocoa and a cherry on top.
    flagToSet: 
    spriteUpdates:
    - mouth drool
    - eyes shut
    pauseForObjective: 1
    objectiveId: day3step5
    showFoodDisplay: 0
  - text: There we go, a nice tiramisu. Ready to serve!
    flagToSet: 
    spriteUpdates:
    - shortcut outtro
    - hands hide
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 1
  - text: "I hope you all enjoy this nice dessert. Whenever you eat my cooking, I
      become\u2026 a part of you."
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  voiceClips: []
  voiceSource: {fileID: 0}
  voiceVolume: 1
  cutOnLineEndClips: []
  autoLoadNextLevel: 1
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
  scenePrompt: {fileID: 852414970}
  eKeyPrompt: {fileID: 852414970}
  eKeyDelay: 0.8
  foodDisplayContainer: {fileID: 803726223}
  foodImage: {fileID: 1378762407}
  completedFoodSprite: {fileID: 21300000, guid: 946150d9a1fd34f76bd61f1384605701, type: 3}
