--- !u!114 &1112481456
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1112481454}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 099a8fd4c3ec1f64a8e07c8e04d02a02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueText: {fileID: 1112481457}
  continueIndicator: {fileID: 0}
  screenSprite: {fileID: 1402779326}
  lines:
  - text: Hi my lovelies, welcome back to my cooking show!
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  - text: "I\u2019m your super-duper-awesome-cutie host, Candy\u2606!"
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  - text: "Today, I\u2019ll teach you how to make scrambled eggs, just like how my
      mother made it."
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  - text: "It\u2019s warm and comforting. Perfect for a quick meal!"
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    - eyes shut
    - hands hide
    pauseForObjective: 0
    objectiveId: 
  - text: "Let\u2019s get cooking!"
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  - text: "First, make sure you have your CookingCandyBox\u2606. It contains all
      of the ingredients you\u2019ll need for today\u2019s recipe."
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  - text: Crack the eggs and pour the milk into the bowl. Then, add some salt and
      pepper to taste.
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 1
    objectiveId: day1step1
  - text: Beat the mixture until thoroughly combined.
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 1
    objectiveId: day1step2
  - text: While you're waiting for the pan to heat up, butter it properly, then add
      the egg mixture. Now, scramble it!
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 1
    objectiveId: day1step3
  - text: "And there we have it. Fluffy scrambled egg that Mama Candy\u2606 used
      to feed me."
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  - text: Have a taste! And remember, whenever you eat my cooking, I become a part
      of you.
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  voiceClips: []
  voiceSource: {fileID: 0}
  voiceVolume: 1
  cutOnLineEndClips: []
  autoLoadNextLevel: 1
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
