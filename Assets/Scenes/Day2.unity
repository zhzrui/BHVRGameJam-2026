--- !u!114 &840838917
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 840838915}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 099a8fd4c3ec1f64a8e07c8e04d02a02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueText: {fileID: 840838918}
  continueIndicator: {fileID: 0}
  screenSprite: {fileID: 771749668}
  lines:
  - text: Hi my lovelies, welcome back to my cooking show!
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    pauseForObjective: 0
    objectiveId: 
  - text: "I\u2019m your cutieful host, Candy\u2606."
    flagToSet: 
    spriteUpdates:
    - mouth tongueout
    - eyes shut
    - hands clasped
    pauseForObjective: 0
    objectiveId: 
  - text: Today, we will be making spicy stir-fried cartilage.
    flagToSet: 
    spriteUpdates:
    - shortcut hungry
    pauseForObjective: 0
    objectiveId: 
  - text: "It\u2019s a dish that is very amusing to eat: crunchy and bouncy."
    flagToSet: 
    spriteUpdates:
    - eyes shut
    - mouth kind
    pauseForObjective: 0
    objectiveId: 
  - text: "Let\u2019s get cooking!"
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
  - text: "Get the vegetables from your CookingCandyBox\u2606. Chop them into medium-thin
      slices and add them to your bowl."
    flagToSet: 
    spriteUpdates:
    - shortcut stare
    pauseForObjective: 1
    objectiveId: day2step1
  - text: "Now, add the cartilage into the bowl too! It might look a little strange
      for people who have never tried it before, but it\u2019s veeeeery yummy!"
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 1
    objectiveId: day2step2
  - text: "Mix, mix, mix~ And now to the pan we go! Stir it until it\u2019s thoroughly
      cooked, then place it into a plate."
    flagToSet: 
    spriteUpdates:
    - mouth tongueout
    - eyes shut
    pauseForObjective: 1
    objectiveId: day2step3
  - text: Now you have yourself a delicious, chewy stir fry with unconventional ingredients!
    flagToSet: 
    spriteUpdates:
    - shortcut hungry
    pauseForObjective: 0
    objectiveId: 
  - text: "Try it out! Don\u2019t forget: whenever you eat my cooking, I become a
      part of you!"
    flagToSet: 
    spriteUpdates:
    - shortcut outtro
    - eyes normal
    pauseForObjective: 0
    objectiveId: 
  voiceClips: []
  voiceSource: {fileID: 0}
  voiceVolume: 1
  cutOnLineEndClips: []
  autoLoadNextLevel: 1
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
  scenePrompt: {fileID: 214588683}
  eKeyPrompt: {fileID: 214588683}
