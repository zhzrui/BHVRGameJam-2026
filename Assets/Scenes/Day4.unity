--- !u!114 &772833777
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 772833775}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 099a8fd4c3ec1f64a8e07c8e04d02a02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueText: {fileID: 772833778}
  continueIndicator: {fileID: 0}
  screenSprite: {fileID: 330914951}
  lines:
  - text: "Hi my lovelies. It\u2019s me, Candy\u2606, the host of\u2026 my own cooking
      show."
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    - eyes shut
    - hair short
    - hands hide
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "I\u2019ve been feeling a little sick lately, so I\u2019ll show you how
      to make my comfort food: steak."
    flagToSet: 
    spriteUpdates:
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "Look into your CookingCandyBox\u2606. "
    flagToSet: 
    spriteUpdates:
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "You\u2019ll find some juicy cuts of steak\u2026 and some vegetables. I
      forgot. I think they\u2019re assorted veggies."
    flagToSet: 
    spriteUpdates:
    - eyes shut
    - hands hide
    - mouth kind
    pauseForObjective: 1
    objectiveId: 
    showFoodDisplay: 0
  - text: Cut the vegetables into pieces. I like to make mine into little finger
      shapes.
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "Actually? I don\u2019t care. Cut them however you like."
    flagToSet: 
    spriteUpdates:
    - shortcut annoyed
    - hands hide
    - eyes shut
    pauseForObjective: 1
    objectiveId: day4step1
    showFoodDisplay: 0
  - text: "And now, the thing we\u2019ve all been waiting for. The steak."
    flagToSet: 
    spriteUpdates:
    - shortcut hungry
    - hands hide
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: Cut them into pieces. Make it match the size of your vegetables.
    flagToSet: 
    spriteUpdates:
    - shortcut stare
    - eyes shut
    pauseForObjective: 1
    objectiveId: day4step2
    showFoodDisplay: 0
  - text: "If you made a pur\xE9e out of them\u2026 I don\u2019t know, turn your
      steak into ground beef or something."
    flagToSet: 
    spriteUpdates:
    - shortcut annoyed
    - hands hide
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: Marinade the steak in sauce. Oh, you know, the one I always make.
    flagToSet: 
    spriteUpdates:
    - shortcut stare
    - hands hide
    - eyes shut
    pauseForObjective: 1
    objectiveId: day4step3
    showFoodDisplay: 0
  - text: Sear all your cuts in a pan. You should be able to smell that delicious
      Maillard reaction.
    flagToSet: 
    spriteUpdates:
    - shortcut hungry
    - hands hide
    - eyes shut
    pauseForObjective: 1
    objectiveId: day4step4
    showFoodDisplay: 0
  - text: Yummy steak strips and vegetables, ready in just a few excruciating minutes.
      And ended in even less.
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 1
  - text: "If you turned them into beef and vegetable mush, great. You failed today\u2019s
      cooking lesson."
    flagToSet: 
    spriteUpdates:
    - shortcut annoyed
    - hands hide
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: ...
    flagToSet: 
    spriteUpdates:
    - shortcut stare
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: I have to go. Goodbye.
    flagToSet: 
    spriteUpdates:
    - shortcut speak
    - eyes shut
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  - text: "Don\u2019t forget that whenever you eat my cooking, I become a part of
      you."
    flagToSet: 
    spriteUpdates: []
    pauseForObjective: 0
    objectiveId: 
    showFoodDisplay: 0
  voiceClips: []
  voiceSource: {fileID: 0}
  voiceVolume: 1
  cutOnLineEndClips: []
  autoLoadNextLevel: 0
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
  onPausedForObjective:
