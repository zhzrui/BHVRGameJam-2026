--- !u!114 &1112481456
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1112481454}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 099a8fd4c3ec1f64a8e07c8e04d02a02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogueText: {fileID: 1112481457}
  continueIndicator: {fileID: 0}
  lines:
  - text: "Hi my lovelies. It\u2019s me, Candy\u2606, the host of\u2026 my own cooking
      show."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "I\u2019ve been feeling a little sick lately, so I\u2019ll show you how
      to make my comfort food: steak."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "Look into your CookingCandyBox\u2606. You\u2019ll find some juicy cuts
      of steak\u2026 and some vegetables. I forgot. I think they\u2019re assorted
      veggies."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: Cut the vegetables into pieces. I like to make mine into little finger
      shapes.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "Actually? I don\u2019t care. Cut them however you like."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "And now, the thing we\u2019ve all been waiting for. The steak."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: Cut them into pieces. Make it match the size of your vegetables.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "If you made a pur\xE9e out of them\u2026 I don\u2019t know, turn your
      steak into ground beef or something."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: Sear all your cuts in a pan. You should be able to smell that delicious
      Maillard reaction.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: Yummy steak strips and vegetables, ready in just a few excruciating minutes.
      And ended in even less.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "If you turned them into ground beef and vegetable mush, great. You failed
      today\u2019s cooking lesson."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: ...
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: I have to go. Goodbye.
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  - text: "Don\u2019t forget that whenever you eat my cooking, I become a part of
      you."
    flagToSet: 
    pauseForObjective: 0
    objectiveId: 
  voiceClips: []
  voiceSource: {fileID: 0}
  voiceVolume: 1
  stopVoiceOnSkip: 0
  cutOnLineEndClips: []
  autoLoadNextLevel: 0
  onDialogueComplete:
    m_PersistentCalls:
      m_Calls: []
  pulseSpeed: 2.5
  minPulseAlpha: 0.3
